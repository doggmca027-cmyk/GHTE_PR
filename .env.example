# ===================================================================================================
# Template of the ONE env file. Copy it:   cp .env.example .env.local   then fill in the values.
# .env.local is GIT-IGNORED: never commit, paste or share it. This example holds NO values.
#
# Fill in the values; every name the project uses is already listed. An EMPTY value means "not set".
# Wrap a value in 'single quotes' if it contains spaces or special characters ($ ! # & ; spaces).
#
# How it is used:
#   npm run dev / build          reads the "FRONTEND" block (Vite exposes ONLY names starting with VITE_)
#   npm run verify:secrets       checks the "EDGE FUNCTION SECRETS" block (never prints values)
#   npm run secrets:push         uploads that block to Supabase (validates first)
#   npx supabase ...             needs the "SUPABASE CLI" block: set -a; . ./.env.local; set +a
#   npm run smoke -- --env-file .env.local      live checks against your deployment
# On Vercel: add the FRONTEND block names in Project -> Settings -> Environment Variables.
# ===================================================================================================


# ===================================================================================================
# 1. SUPABASE CLI (deploying from this machine). Never uploaded anywhere.
# ===================================================================================================
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Database password (db push / link). Optional: leave empty and the CLI will ask.
SUPABASE_DB_PASSWORD=


# ===================================================================================================
# 2. EDGE FUNCTION SECRETS (uploaded to Supabase by `npm run secrets:push`)
# ===================================================================================================
# ---- required --------------------------------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Project JWT secret: Dashboard -> Project Settings -> API / JWT Keys. NOT an API key.
JWT_SECRET=
# Random string, 32+ characters (e.g. `openssl rand -hex 32`). Protects the background workers.
CRON_SECRET=
# YOUR wallet that receives deposits, user-friendly form (UQ... / EQ...).
TON_RECIPIENT_ADDRESS=
# Exactly "testnet" (no real money) or "mainnet".
TON_NETWORK=testnet
# API key of your SMM panel. Name = PROVIDER_ + provider name UPPERCASE (non-alphanumerics -> _) + _API_KEY,
# e.g. provider "Secsers" -> PROVIDER_SECSERS_API_KEY. Rename the line below to match your provider.
PROVIDER_YOURPANEL_API_KEY=

# ---- strongly recommended --------------------------------------------------------------------------
# Telegram user ids that become admins on next sign-in, comma-separated (ask @userinfobot).
ADMIN_TELEGRAM_IDS=
# Your frontend origin, e.g. https://your-app.vercel.app (no trailing slash). Empty = any website may call the API.
ALLOWED_ORIGIN=
# Free key from https://t.me/tonapibot (lifts the ~1 request/second Toncenter limit).
TONCENTER_API_KEY=

# ---- optional --------------------------------------------------------------------------------------
# 32 random bytes in base64 (openssl rand -base64 32): only if you store provider keys encrypted in the database.
PROVIDER_KEY_SECRET=
# Orders checked per status-sync run (1-200, default 50).
SYNC_BATCH_SIZE=
# Refund orders the provider never confirmed after this many minutes (default 60, keep >= 15).
RECONCILE_AFTER_MINUTES=
# Override the Toncenter endpoint (default depends on TON_NETWORK).
TONCENTER_URL=


# ===================================================================================================
# 3. FRONTEND (Vite / Vercel). EVERYTHING here is public once built: never put a secret in this block.
# ===================================================================================================
# ---- required --------------------------------------------------------------------------------------
VITE_SUPABASE_URL=
# The PUBLIC anon / publishable key (Project Settings -> API Keys). NEVER the service_role / secret key.
VITE_SUPABASE_ANON_KEY=

# ---- recommended -----------------------------------------------------------------------------------
# Where Telegram returns the user after approving in Tonkeeper: https://t.me/<bot_username>/<app_short_name>
VITE_TWA_RETURN_URL=

# ---- optional --------------------------------------------------------------------------------------
# Public URL of the deployed site (needed only for a custom domain; Vercel is detected automatically).
APP_URL=
# Terms / privacy links in the wallet dialog default to <site>/terms and <site>/privacy (pages ship in public/).
# Set these ONLY to point at your own pages instead.
TERMS_URL=
PRIVACY_URL=
# Only if the TON Connect manifest is hosted elsewhere.
VITE_TONCONNECT_MANIFEST_URL=


# ===================================================================================================
# 4. DEVELOPMENT ONLY. Left commented on purpose: setting these in production is a serious mistake.
#    (MOCK_MODE=true makes the server accept orders without calling the provider; VITE_MOCK_MODE=true
#     serves fake data. Both are rejected by the production checks.)
# ===================================================================================================
# MOCK_MODE=true
# TON_USD_FALLBACK_RATE=5
# VITE_MOCK_MODE=true
# VITE_MOCK_SUBMITTED_MS=4000
# VITE_MOCK_COMPLETED_MS=20000

# --- Real provider E2E (npm run e2e:provider) - local only, never uploaded as a function secret --------
# PROVIDER_TEST_URL=https://<your panel>/api/v2
# PROVIDER_TEST_KEY=
