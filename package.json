{
  "name": "smm-mini-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node --disable-warning=ExperimentalWarning scripts/verify-env.ts",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node --disable-warning=ExperimentalWarning scripts/postbuild.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:env": "node --disable-warning=ExperimentalWarning scripts/verify-env.ts",
    "verify:secrets": "node --disable-warning=ExperimentalWarning scripts/verify-secrets.ts",
    "scan:secrets": "node --disable-warning=ExperimentalWarning scripts/scan-secrets.ts",
    "check:supabase": "node --disable-warning=ExperimentalWarning scripts/check-supabase.ts",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-test.ts",
    "check": "npm run scan:secrets && npm run check:supabase && npm test && npm run build",
    "secrets:push": "node --disable-warning=ExperimentalWarning scripts/push-secrets.ts",
    "test:concurrency": "node --disable-warning=ExperimentalWarning scripts/concurrency-test.ts",
    "e2e:provider": "node --disable-warning=ExperimentalWarning scripts/provider-e2e.ts",
    "test:ton": "node --disable-warning=ExperimentalWarning scripts/ton-e2e.ts",
    "secrets:rotate": "node --disable-warning=ExperimentalWarning scripts/rotate-secrets.ts",
    "smoke:live": "node --disable-warning=ExperimentalWarning scripts/live-smoke-test.ts",
    "observe:live": "node --disable-warning=ExperimentalWarning scripts/observe-live-test.ts",
    "i18n:keys": "node --disable-warning=ExperimentalWarning scripts/i18n-keys.ts"
  },
  "dependencies": {
    "@tonconnect/ui-react": "^3.0.2",
    "@twa-dev/sdk": "^8.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ton/core": "^0.63.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
