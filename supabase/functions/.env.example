# Supabase Edge Function secrets.
#
# Reference list of the Edge Function secrets. You do NOT use this file directly any more:
# every name below is already in the root .env.example / .env.local, and `npm run secrets:push`
# uploads them. Run `npm run verify:secrets` first.
#
# The real file is git-ignored. Names starting with SUPABASE_ are reserved: Supabase already injects
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into every function.

# ========== REQUIRED =================================================================================
# Bot token from @BotFather. Verifies Telegram sign-in and sends notifications.
TELEGRAM_BOT_TOKEN=
# The project's JWT secret (Project Settings -> API -> JWT Secret). Tokens issued by telegram-auth are
# signed with it, so Supabase (RLS) and the functions both accept them.
JWT_SECRET=
# Shared secret for the scheduler: openssl rand -hex 32
CRON_SECRET=
# YOUR wallet that receives deposits, user-friendly form (UQ... / EQ...). Never accepted from clients.
TON_RECIPIENT_ADDRESS=
# Exactly "mainnet" or "testnet". Anything else is treated as mainnet.
TON_NETWORK=mainnet

# ========== LIVE SMM PROVIDER ==========================================================================
# One per provider row in the `providers` table. NAME = provider name, upper-cased, every run of
# non-alphanumerics replaced by "_".   "Secsers" -> PROVIDER_SECSERS_API_KEY
# "My Panel.io" -> PROVIDER_MY_PANEL_IO_API_KEY
# PROVIDER_SECSERS_API_KEY=
# Alternative: store keys AES-encrypted in providers.api_key_encrypted and keep only this secret here
# (32 random bytes, base64: openssl rand -base64 32).
# PROVIDER_KEY_SECRET=

# ========== STRONGLY RECOMMENDED =====================================================================
# Comma-separated Telegram user ids promoted to admin on their next sign-in (bootstrap only, never demotes).
# ADMIN_TELEGRAM_IDS=123456789
# Your app origin, so only your site can call the functions from a browser (no trailing slash).
# ALLOWED_ORIGIN=https://your-app.vercel.app
# Higher Toncenter rate limit (free key from https://t.me/tonapibot). Without it ~1 request/second.
# TONCENTER_API_KEY=

# ========== OPTIONAL TUNING ==========================================================================
# SYNC_BATCH_SIZE=50
# RECONCILE_AFTER_MINUTES=60
# TONCENTER_URL=https://toncenter.com

# ========== DEVELOPMENT ONLY: never in production ====================================================
# MOCK_MODE=true
# TON_USD_FALLBACK_RATE=5
