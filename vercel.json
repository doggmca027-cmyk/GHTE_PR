{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/:slug(buy-telegram-followers|buy-telegram-views|buy-telegram-reactions|buy-telegram-premium-followers|buy-instagram-followers|buy-instagram-likes|buy-instagram-views|buy-instagram-comments|buy-instagram-real-followers|buy-tiktok-followers|buy-tiktok-likes|buy-tiktok-views|buy-tiktok-comments|buy-youtube-followers|buy-youtube-views|buy-youtube-likes|buy-youtube-comments|buy-twitter-followers|buy-twitter-likes|buy-twitter-views|buy-facebook-followers|buy-facebook-likes|buy-facebook-views|buy-spotify-plays|buy-spotify-followers|buy-twitch-followers|buy-twitch-views|buy-vk-followers|buy-vk-likes|buy-vk-views|crypto-smm-panel|smm-panel-for-agencies){/}?", "destination": "/en/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:lang(en|ru|uk|es|pt|id|tr|ar|hi|fr|de|it|vi|zh|ja){/}?", "destination": "/" },
    { "source": "/:lang(en|ru|uk|es|ar)/:slug(buy-telegram-followers|buy-telegram-views|buy-telegram-reactions|buy-telegram-premium-followers|buy-instagram-followers|buy-instagram-likes|buy-instagram-views|buy-instagram-comments|buy-instagram-real-followers|buy-tiktok-followers|buy-tiktok-likes|buy-tiktok-views|buy-tiktok-comments|buy-youtube-followers|buy-youtube-views|buy-youtube-likes|buy-youtube-comments|buy-twitter-followers|buy-twitter-likes|buy-twitter-views|buy-facebook-followers|buy-facebook-likes|buy-facebook-views|buy-spotify-plays|buy-spotify-followers|buy-twitch-followers|buy-twitch-views|buy-vk-followers|buy-vk-likes|buy-vk-views|crypto-smm-panel|smm-panel-for-agencies){/}?", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://telegram.org; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.ton.org https://*.tonapi.io https://raw.githubusercontent.com https://api.coingecko.com https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src 'self' https://*.telegram.org; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://webk.telegram.org https://webz.telegram.org https://*.telegram.org; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/tonconnect-manifest.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/tonconnect-icon.png",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js|manifest.webmanifest|workbox-.*.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/llm-context.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
